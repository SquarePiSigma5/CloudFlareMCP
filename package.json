{
  "name": "cloudflare-dns-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the Cloudflare API — typed DNS convenience tools plus a guarded passthrough to any v4 endpoint the token is scoped for; usable from any MCP client over stdio or streamable HTTP",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cloudflare-dns-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test scripts/guard-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
