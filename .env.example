# Required: scoped Cloudflare API token (template "Edit zone DNS", limit to your zones)
CLOUDFLARE_API_TOKEN=

# Strongly recommended: bearer token clients must present to reach this server
MCP_AUTH_TOKEN=

# Permits a non-localhost bind WITHOUT MCP_AUTH_TOKEN set — otherwise the server refuses to start
# in that configuration. Only use it when auth is terminated upstream (e.g. Cloudflare Access in
# front of a tunnel); anyone who can reach the port could otherwise edit your DNS.
# ALLOW_UNAUTHENTICATED=true

# Guarded raw Cloudflare API passthrough (cloudflare_api_request tool). Reads enabled by default.
#   unset (default) / read / anything unrecognized -> READS: GET/HEAD to any endpoint the token can
#                                                     reach (NOT just DNS); mutating methods refused.
#   full                                           -> also POST/PUT/PATCH/DELETE, each only when the
#                                                     call sends confirm=true.
#   off                                            -> DISABLED: every passthrough call is refused.
# WARNING: reads are scoped by the token, not by DNS — the default (unset/read) exposes every GET/HEAD
# endpoint the token can reach. 'full' additionally lets the model make mutating calls to ANY endpoint
# the token permits — including irreversible, account-wide actions (e.g. deleting a zone, creating/
# revoking API tokens, member changes). It is a single process-wide switch shared by every holder of
# MCP_AUTH_TOKEN; confirm=true is set by the model, not a human, so it does not gate against prompt
# injection. Keep the Cloudflare token as narrowly scoped as possible, and set =off to disable the
# tool entirely.
# CLOUDFLARE_API_PASSTHROUGH=read

# --- Workers tools (both OFF by default; opt in explicitly) ---
#
# Cloudflare account ID (32-char hex) for the account-scoped Workers endpoints. Optional: if unset,
# each Workers tool falls back to the token's sole visible account (and errors, listing the accounts,
# when the token can see more than one). You can also pass account_id per call.
# CLOUDFLARE_ACCOUNT_ID=
#
# cloudflare_set_worker_secret_from_env — sets a Worker secret whose VALUE is read from THIS server's
# own environment, so the secret never passes through the model, the tool call, the output, or logs.
# The model only names WHICH allowlisted env var to read. BOTH allowlists below must be non-empty or
# the tool refuses every call.
#   CLOUDFLARE_WORKER_SECRET_ENV_ALLOWLIST    comma-separated env var NAMES the tool may read as a
#                                             secret value, e.g. "MY_SERVICE_API_KEY". Exact, case-sensitive
#                                             match. CLOUDFLARE_API_TOKEN, MCP_AUTH_TOKEN, and
#                                             ALLOW_UNAUTHENTICATED can NEVER be exposed even if listed.
#   CLOUDFLARE_WORKER_SECRET_SCRIPT_ALLOWLIST comma-separated Worker script NAMES that may RECEIVE a
#                                             secret, e.g. "my-worker". Exact, case-sensitive
#                                             match. SEPARATION OF DUTIES: any script listed here is
#                                             REFUSED by cloudflare_deploy_worker, so a secret only ever
#                                             lands on a Worker the operator deployed out-of-band — never
#                                             on model-authored code. Empty ⇒ no script may receive a
#                                             secret at all.
# CLOUDFLARE_WORKER_SECRET_ENV_ALLOWLIST=MY_SERVICE_API_KEY
# CLOUDFLARE_WORKER_SECRET_SCRIPT_ALLOWLIST=my-worker
#
# cloudflare_deploy_worker — uploads/deploys a Worker script (runs arbitrary JavaScript inside the
# account). Disabled unless set to the EXACT value 'true' (a typo/case never enables it). Each deploy
# also requires confirm=true. It REFUSES any script name in CLOUDFLARE_WORKER_SECRET_SCRIPT_ALLOWLIST
# (separation of duties: the model can never both author a Worker's code and bind an allowlisted secret
# to it). Keep the Cloudflare token narrowly scoped: the token is the real boundary.
# CLOUDFLARE_WORKERS_DEPLOY_ENABLE=true

# Optional (defaults shown)
HOST=127.0.0.1
PORT=8787
TRANSPORT=http
# ALLOWED_ORIGINS=https://example.com

# Optional: override the MCP endpoint URL that `npm run smoke` connects to (default http://127.0.0.1:8787/mcp)
# MCP_URL=http://127.0.0.1:8787/mcp
